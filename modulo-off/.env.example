# Puerto del API local
PORT=4000

# Postgres local (docker compose up -d). Si queda vacio, el modulo usa el
# repositorio en memoria (util para probar rapido sin levantar la BD).
DATABASE_URL=postgres://off:off@localhost:5433/vallis_off

# Aplica las migraciones de ./sql al arrancar el server
MIGRATE_ON_START=false

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_MS=3000
OFF_USER_AGENT=Vallis/0.1 (https://vallis.com.ar; contacto@vallis.com.ar)

# Origenes permitidos por CORS (frontend Vite en local)
ALLOW_ORIGIN=*
